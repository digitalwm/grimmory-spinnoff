# Copy to the deployment project directory as .env and fill in local credentials.
# Use the repository root as the Compose project directory for a fresh clone.
GRIMMORY_SOURCE=.
CALIBRE_IMPORTER_SOURCE=./calibre-importer
APP_USER_ID=1000
APP_GROUP_ID=1000
TZ=Europe/Berlin
DATABASE_URL=jdbc:mariadb://mariadb:3306/grimmory
DB_USER=grimmory
DB_PASSWORD=replace-with-a-unique-database-password
DB_USER_ID=1000
DB_GROUP_ID=1000
MYSQL_ROOT_PASSWORD=replace-with-a-different-root-password
MYSQL_DATABASE=grimmory
API_DOCS_ENABLED=false
DISK_TYPE=LOCAL
BOOKS_PATH=./books
BOOKDROP_PATH=./bookdrop
SOURCE_EPUB_PATH=./sources/epub
SOURCE_CLEAN_PATH=./sources/epub_clean
SOURCE_MANAGED_PATH=./sources/epub-managed/managed-library
GRIMMORY_USERNAME=replace-with-your-grimmory-username
GRIMMORY_PASSWORD=replace-with-your-grimmory-password
GRIMMORY_LOW_SCORE_THRESHOLD=65
GRIMMORY_HTTP_RETRY_ATTEMPTS=3
GRIMMORY_HTTP_RETRY_DELAY_SECONDS=2
GRIMMORY_UPDATE_TIMEOUT_SECONDS=60
LLM_BASE_URL=http://your-llm-server:8000/v1
LLM_API_KEY=replace-with-your-llm-api-key
LLM_MODEL=replace-with-your-model-name
LLM_TIMEOUT_SECONDS=120
LLM_RETRY_ATTEMPTS=3
LLM_BOOK_SAMPLE_PAGES=2

# Duplicate copies expire after 30 days. Set 0 to disable automatic quarantine purging.
APP_CATALOGUE_QUARANTINE_RETENTION_DAYS=30
